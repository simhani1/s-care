# 로컬 실행용 예시. 복사해서 .env 로 저장한다: cp .env.example .env
# docker-compose.yml 의 기본값과 맞춰져 있다. 운영 값은 절대 커밋하지 않는다.

LOCAL_MYSQL_URL=jdbc:mysql://localhost:3306/scare?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
LOCAL_MYSQL_USER=scare
LOCAL_MYSQL_PASSWORD=scare

RABBITMQ_URL=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=scare
RABBITMQ_PWD=scare

LOCAL_MONGODB_URI=mongodb://localhost:27017
LOCAL_MONGODB_DATABASE=scare

# HS256 서명 키. 32바이트 이상
JWT_SECRET_KEY=local-dev-only-secret-key-change-me-0123456789
JWT_ISSUER=scare-local
JWT_SALT=local-salt
JWT_ACCESS_TOKEN_EXPIRATION=3600000
JWT_REFRESH_TOKEN_EXPIRATION=1209600000

SWAGGER_UI_PATH=/swagger-ui
SWAGGER_API_DOCS_PATH=/api-docs

FAST_API_BASE_URL=http://localhost:8000
STRESS_ENDPOINT=/stress
FCM_SERVICE_ACCOUNT_KEY=unused
